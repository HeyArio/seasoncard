10:T60e,[{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Season Card","item":"https://seasoncard.app/"},{"@type":"ListItem","position":2,"name":"Guides","item":"https://seasoncard.app/guides"},{"@type":"ListItem","position":3,"name":"How to find your undertone (and why it changes in photos)","item":"https://seasoncard.app/guides/how-to-find-your-undertone"}]},{"@context":"https://schema.org","@type":"Article","headline":"How to find your undertone (and why it changes in photos)","description":"Warm, cool or neutral? The reliable at-home undertone tests, why the vein test misleads, and why photos make you look warmer or cooler.","mainEntityOfPage":"https://seasoncard.app/guides/how-to-find-your-undertone","dateModified":"2026-10-03","author":{"@type":"Organization","name":"Season Card","url":"https://seasoncard.app/"},"publisher":{"@type":"Organization","name":"Season Card","url":"https://seasoncard.app/"}},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a neutral undertone?","acceptedAnswer":{"@type":"Answer","text":"A neutral undertone sits between warm and cool, so both gold and silver can look fine. Neutral-leaning seasons include Soft Autumn and Soft Summer."}},{"@type":"Question","name":"Is undertone the same as skin tone?","acceptedAnswer":{"@type":"Answer","text":"No. Skin tone is how light or deep your skin is. Undertone is the warm or cool cast underneath, and any skin tone can have any undertone."}}]}]6:["$","main",null,{"className":"page","children":[["$","header",null,{"className":"site-header no-print","children":[["$","$L5",null,{"href":"/","className":"brand","aria-label":"Season Card home","children":[["$","svg",null,{"viewBox":"0 0 30 22","aria-hidden":true,"children":[["$","circle",null,{"cx":"8","cy":"11","r":"7.5","fill":"#B5705A"}],["$","circle",null,{"cx":"15","cy":"11","r":"7.5","fill":"#8A8F5E","fillOpacity":"0.92"}],["$","circle",null,{"cx":"22","cy":"11","r":"7.5","fill":"#5F7F82","fillOpacity":"0.92"}]]}],"Season Card"]}],["$","$L5",null,{"href":"/scan","className":"header-link","children":"Free scan"}]]}],["$","article",null,{"className":"content","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],["$","nav",null,{"className":"crumbs small muted","aria-label":"Breadcrumb","children":[["$","span","Guides",{"children":["",["$","$L5",null,{"href":"/guides","children":"Guides"}]]}],["$","span","How to find your undertone (and why it changes in photos)",{"children":[" / ","How to find your undertone (and why it changes in photos)"]}]]}],["$","h1",null,{"style":{"marginTop":12},"children":"How to find your undertone (and why it changes in photos)"}],["$","p",null,{"className":"lede-answer","children":"To find your undertone, look at your bare skin in indirect daylight and compare how warm (golden, peachy) and cool (pink, blue-red) colours make it look. If warm colours make your skin look even and glowing, you likely have a warm undertone; if cool colours do, a cool one; if both work, you may be neutral."}],[["$","section","Why your undertone looks different in every photo",{"className":"section","children":[["$","h2",null,{"className":"section-title","children":"Why your undertone looks different in every photo"}],[["$","p","Warm light bulbs push skin yello",{"style":{"marginBottom":10},"children":"Warm light bulbs push skin yellow-orange, so everyone looks warm. Shade and overcast light push skin blue, so everyone looks cool. Phone cameras also auto-correct white balance, and beauty filters change skin tone."}],["$","p","That's a big reason people get d",{"style":{"marginBottom":10},"children":"That's a big reason people get different answers from different quizzes. Fix the light and results get more consistent."}]],null]}],"$L11","$L12"],"$L13","$L14","$L15"]}],"$L16"]}]
11:["$","section","Tests that work",{"className":"section","children":[["$","h2",null,{"className":"section-title","children":"Tests that work"}],[["$","p","Do these facing a window, with n",{"style":{"marginBottom":10},"children":"Do these facing a window, with no direct sun and no makeup."}]],["$","ul",null,{"className":"bullets","children":[["$","li","Metal test: hold gold and silver (or foil) under your chin. Whichever makes your skin look more even points to your undertone.",{"children":"Metal test: hold gold and silver (or foil) under your chin. Whichever makes your skin look more even points to your undertone."}],["$","li","Fabric test: compare a warm colour (camel, peach) with a cool one (grey-blue, rose) next to your face.",{"children":"Fabric test: compare a warm colour (camel, peach) with a cool one (grey-blue, rose) next to your face."}],["$","li","White test: pure white versus cream. Cool undertones usually suit pure white; warm undertones often look better in cream.",{"children":"White test: pure white versus cream. Cool undertones usually suit pure white; warm undertones often look better in cream."}]]}]]}]
12:["$","section","Why the vein test is unreliable",{"className":"section","children":[["$","h2",null,{"className":"section-title","children":"Why the vein test is unreliable"}],[["$","p","Vein colour depends on lighting,",{"style":{"marginBottom":10},"children":"Vein colour depends on lighting, skin thickness and the room you're in, so it often gives the wrong answer. Use the metal or fabric test instead."}]],null]}]
