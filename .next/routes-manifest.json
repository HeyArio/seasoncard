      "namedRegex": "^/checkout(?:/)?$"
    },
    {
      "page": "/guides",
      "regex": "^/guides(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/guides(?:/)?$"
    },
    {
      "page": "/icon.svg",
      "regex": "^/icon\\.svg(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.svg(?:/)?$"
    },
    {
      "page": "/mediapipe/face_landmarker.task",
      "regex": "^/mediapipe/face_landmarker\\.task(?:/)?$",
      "routeKeys": {},
