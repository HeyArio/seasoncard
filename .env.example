# Public PayPal REST app client id (safe for the browser; used to load the PayPal JS SDK)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Server-side PayPal REST credentials (same app as above)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox
# Returned by POST /api/admin/setup (x-admin-key: $ADMIN_KEY). Set it, then redeploy.
PAYPAL_WEBHOOK_ID=
# Long random string, e.g. `openssl rand -base64 48`. Rotating it invalidates every issued report link.
REPORT_TOKEN_SECRET=
# Long random string for the /api/admin/* endpoints (sent as the x-admin-key header)
ADMIN_KEY=
# Public origin with no trailing slash, e.g. https://seasoncard.app
SITE_URL=
